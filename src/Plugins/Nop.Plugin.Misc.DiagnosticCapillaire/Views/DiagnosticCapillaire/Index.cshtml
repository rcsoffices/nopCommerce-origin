@{
    Layout = "_ColumnsOne";
    NopHtml.AppendPageCssClassParts("html-kalidiag-page");
    NopHtml.AddTitleParts("Diagnostic capillaire");
}

@* Loader affiché pendant initQuestion() *@
<div id="diag-loader" class="diag-loader" aria-live="polite" aria-label="Chargement du diagnostic">
    <div class="diag-loader-spinner"></div>
    <p class="diag-loader-text">Chargement…</p>
</div>

<div class="page kalidiag-page" id="diag-page" hidden>
    <div class="page-title">
        <h1>Diagnostic capillaire</h1>
    </div>
    <div class="page-body">

        <form id="questions" class="questions"></form>

        <div id="diag-message" class="diag-message"></div>

        <div class="diag-submit">
            <button id="diag-button" type="button" class="diag-button">
                Voir mon résultat
            </button>
        </div>

    </div>
</div>

@* Overlay résultat — slide-up animé *@
<div id="resultOverlay" class="diag-result-overlay" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="diag-result-card">
        <span class="diag-result-ornament" aria-hidden="true">✦</span>
        <hr class="diag-result-divider" />
        <h2 class="diag-result-title">Votre diagnostic</h2>
        <div id="resultValue" class="diag-result-body"></div>
        <hr class="diag-result-divider" />
        <button type="button" id="diag-close-btn" class="diag-result-close">Fermer</button>
    </div>
</div>

<script asp-location="Footer">
    // ── Helpers ────────────────────────────────────────────────────────────
    function createElementFromHTML(html) {
        const div = document.createElement('div');
        div.innerHTML = html.trim();
        return div.firstChild;
    }

    // ── Loader ─────────────────────────────────────────────────────────────
    function showLoader() {
        const l = document.getElementById('diag-loader');
        l.classList.remove('diag-loader--hidden');
        l.removeAttribute('aria-hidden');
    }

    function hideLoader() {
        const l = document.getElementById('diag-loader');
        l.classList.add('diag-loader--hidden');
        l.setAttribute('aria-hidden', 'true');
        const page = document.getElementById('diag-page');
        page.removeAttribute('hidden');
    }

    // ── Result overlay ─────────────────────────────────────────────────────
    function openResult(html) {
        const overlay = document.getElementById('resultOverlay');
        document.getElementById('resultValue').innerHTML = html;
        overlay.classList.add('diag-result-overlay--open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
    }

    function closeResult() {
        const overlay = document.getElementById('resultOverlay');
        overlay.classList.remove('diag-result-overlay--open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        document.getElementById('resultValue').innerHTML = '';
    }

    // ── Submit ─────────────────────────────────────────────────────────────
    async function submitForm() {
        const form = document.getElementById('questions');
        const formData = new FormData(form);
        const results = {};
        formData.forEach((value, key) => { results[key] = value; });

        document.getElementById('diag-message').innerHTML = '';
        for (let i = 1; i <= 5; i++) {
            const flagEl = document.getElementById(`question_required_${i}`);
            if (flagEl) flagEl.innerHTML = '';
            if (!results[i]) {
                document.getElementById('diag-message').innerHTML =
                    '<p>Désolé, nous avons besoin d\'une info supplémentaire &#x1F623;</p>';
                if (flagEl) flagEl.innerHTML = '&#x1F6A9;';
                return;
            }
        }

        const btn = document.getElementById('diag-button');
        btn.disabled = true;
        btn.textContent = 'Analyse en cours…';

        try {
            const reponseResult = { ...results };
            const email = reponseResult['email'] ?? '';
            delete reponseResult['email'];
            const responses = Object.values(reponseResult).join('');

            const res = await fetch(
                `https://${location.host}/api/diagnosticcapillaire/response?questionResp=${responses}&email=${encodeURIComponent(email)}`
            );
            const data = await res.json();
            openResult(data.Data ?? 'Aucun résultat trouvé.');
        } catch (e) {
            document.getElementById('diag-message').innerHTML =
                '<p>Une erreur est survenue, veuillez réessayer. &#x1F615;</p>';
        } finally {
            btn.disabled = false;
            btn.textContent = 'Voir mon résultat';
        }
    }

    // ── Init questions ─────────────────────────────────────────────────────
    async function initQuestion() {
        const res = await fetch(`https://${location.host}/api/diagnosticcapillaire/questions`);
        const data = await res.json();
        const container = document.querySelector('.questions');

        data.Data?.forEach((q) => {
            container.appendChild(createElementFromHTML(`
                <div class="question">
                    <h2 class="diag-subtitle">* ${q.question}</h2>
                    <div id="question_required_${q.id}"></div>
                    <section class="diag-choice" id="${q.id}">
                        ${q.responses.map(r => `
                            <input id="${q.id}_${r.id}" type="radio"
                                   class="diag-button-input"
                                   name="${q.id}" value="${r.id}">
                            <label for="${q.id}_${r.id}"><p>${r.value}</p></label>
                        `).join('')}
                    </section>
                </div>
            `));
        });

        container.appendChild(createElementFromHTML(`
            <div class="question">
                <h2 class="diag-subtitle">Email</h2>
                <section class="diag-choice">
                    <input type="text" class="diag-text-input" name="email"
                           placeholder="(ex: johndoe@kalibeenne.fr)">
                </section>
            </div>
        `));
    }

    // ── Bootstrap ──────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', async () => {
        showLoader();
        try {
            await initQuestion();
        } finally {
            hideLoader();
        }

        document.getElementById('diag-button')
            .addEventListener('click', () => submitForm());

        document.getElementById('diag-close-btn')
            .addEventListener('click', closeResult);

        // Close on backdrop click
        document.getElementById('resultOverlay')
            .addEventListener('click', (e) => {
                if (e.target === e.currentTarget) closeResult();
            });

        // Close on Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeResult();
        });
    });
</script>
