@using Nop.Plugin.Misc.DiagnosticCapillaire
@using Nop.Plugin.Misc.DiagnosticCapillaire.Models
@model KalidiagPageModel

@{
    Layout = "_ColumnsOne";
    NopHtml.AppendPageCssClassParts("html-kalidiag-page");
    NopHtml.AddTitleParts("Diagnostic capillaire");

    var isResultOpen = !string.IsNullOrWhiteSpace(Model.ResultHtml);
}

<div class="page kalidiag-page" id="diag-page">
    <div class="page-title">
        <h1>Diagnostic capillaire</h1>
    </div>
    <div class="page-body">

        <div id="diag-form-errors" class="diag-form-errors">
            @if (Model.Errors.TryGetValue("form", out var formErrors) && formErrors.Any())
            {
                <div class="diag-form-alert diag-error-target" role="alert" aria-live="assertive" tabindex="-1">
                    <div class="diag-form-alert-title">Le formulaire contient des erreurs</div>
                    @foreach (var error in formErrors)
                    {
                        <div class="diag-form-alert-message">@error</div>
                    }
                </div>
            }
        </div>

        <form id="questions"
              class="questions"
              action="@Url.RouteUrl(DiagnosticCapillaireDefaults.KalidiagRouteName)"
              method="post">
            @Html.AntiForgeryToken()

            @foreach (var question in Model.Questions)
            {
                var questionKey = $"question_{question.id}";
                var hasQuestionError = Model.Errors.TryGetValue(questionKey, out var questionErrors) && questionErrors.Any();
                var selectedAnswer = Model.Answers.TryGetValue(question.id, out var answerId) ? answerId : string.Empty;

                <div class="question">
                    <h2 class="diag-subtitle">* @question.question</h2>
                    <div id="question_required_@question.id"
                         class="diag-question-error-flag @(hasQuestionError ? "diag-question-error-flag--visible" : string.Empty)"
                         aria-hidden="@(!hasQuestionError)">
                        <span class="diag-question-error-bullet" aria-hidden="true"></span>
                    </div>

                    <section class="diag-choice" id="@question.id">
                        @foreach (var response in question.responses)
                        {
                            var inputId = $"{question.id}_{response.id}";

                            <input id="@inputId"
                                   type="radio"
                                   class="diag-button-input"
                                   name="Answers[@question.id]"
                                   value="@response.id"
                                   @(selectedAnswer == response.id ? "checked" : null)>
                            <label for="@inputId"><span class="diag-choice-text">@response.value</span></label>
                        }
                    </section>
                </div>
            }

            <div class="question">
                <h2 class="diag-subtitle">Email</h2>
                @if (Model.Errors.TryGetValue("email", out var emailErrors) && emailErrors.Any())
                {
                    <div class="field-validation-error diag-error-target" role="alert" tabindex="-1">@string.Join(" ", emailErrors)</div>
                }
                <section class="diag-choice">
                    <input type="text"
                           class="diag-text-input"
                           name="Email"
                           value="@Model.Email"
                           placeholder="(ex: johndoe@kalibeenne.fr)">
                </section>
            </div>

            <div class="diag-submit">
                <button id="diag-button" type="submit" class="diag-button">
                    Voir mon résultat
                </button>
            </div>
        </form>

    </div>
</div>

<div id="diag-submit-loader"
     class="diag-loader diag-loader--hidden"
     aria-live="polite"
     aria-hidden="true"
     aria-label="Analyse en cours">
    <div class="diag-loader-spinner"></div>
    <p class="diag-loader-text">Analyse en cours...</p>
</div>

@* Overlay résultat — slide-up animé *@
<div id="resultOverlay"
     class="diag-result-overlay @(isResultOpen ? "diag-result-overlay--open" : string.Empty)"
     role="dialog"
     aria-modal="true"
     aria-hidden="@(isResultOpen ? "false" : "true")">
    <div class="diag-result-card">
        <span class="diag-result-ornament" aria-hidden="true">✦</span>
        <hr class="diag-result-divider" />
        <h2 class="diag-result-title">Votre diagnostic</h2>
        <div id="resultValue" class="diag-result-body">@Html.Raw(Model.ResultHtml)</div>
        <hr class="diag-result-divider" />
        <button type="button" id="diag-close-btn" class="diag-result-close">Fermer</button>
    </div>
</div>

<script asp-location="Footer">
    const kalidiagResultStorageKey = @Html.Raw(Json.Serialize(DiagnosticCapillaireDefaults.KalidiagResultStorageKey));
    const serverResultHtml = @Html.Raw(Json.Serialize(Model.ResultHtml ?? string.Empty));
    const serverErrors = @Html.Raw(Json.Serialize(Model.Errors));

    // ── Result overlay ─────────────────────────────────────────────────────
    function showSubmitLoader() {
        const loader = document.getElementById('diag-submit-loader');
        if (!loader) {
            return;
        }

        loader.classList.remove('diag-loader--hidden');
        loader.setAttribute('aria-hidden', 'false');

        const submitButton = document.getElementById('diag-button');
        if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = 'Analyse en cours...';
        }
    }

    function closeResult() {
        const overlay = document.getElementById('resultOverlay');
        overlay.classList.remove('diag-result-overlay--open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    }

    function notifySubmitErrors(errors) {
        if (!errors) {
            return;
        }

        const displayedMessages = new Set();

        Object.keys(errors).forEach((key) => {
            const messages = errors[key] || [];

            messages.forEach((message) => {
                if (!message || displayedMessages.has(message)) {
                    return;
                }

                displayedMessages.add(message);
                displayBarNotification(message, 'error', 0);
            });
        });
    }

    function focusFirstError() {
        const firstError = document.querySelector('.diag-error-target');
        if (!firstError) {
            return;
        }

        firstError.classList.remove('diag-error-target--active');
        void firstError.offsetWidth;
        firstError.classList.add('diag-error-target--active');

        firstError.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
        });

        if (typeof firstError.focus === 'function') {
            firstError.focus({ preventScroll: true });
        }
    }

    // ── Bootstrap ──────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof serverResultHtml === 'string' && serverResultHtml.trim().length > 0) {
            try {
                localStorage.setItem(kalidiagResultStorageKey, serverResultHtml);
            } catch (_) {
                // Ignore localStorage errors (private mode / quota)
            }
        }

        notifySubmitErrors(serverErrors);
        focusFirstError();

        document.getElementById('questions')
            .addEventListener('submit', showSubmitLoader);

        const overlay = document.getElementById('resultOverlay');
        if (overlay.classList.contains('diag-result-overlay--open')) {
            document.body.style.overflow = 'hidden';
        }

        document.getElementById('diag-close-btn')
            .addEventListener('click', closeResult);

        // Close on backdrop click
        document.getElementById('resultOverlay')
            .addEventListener('click', (e) => {
                if (e.target === e.currentTarget) closeResult();
            });

        // Close on Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeResult();
        });
    });
</script>
