@using Nop.Core
@using Nop.Core.Domain.Catalog

@inject CatalogSettings catalogSettings
@inject IWorkContext workContext

@{
    /* Kalibeenne theme - no RTL support needed */
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/1900.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/1600.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/1366.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/1280.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/1024.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/900.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/768.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/480.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/mobile.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/tables.css");
    NopHtml.AppendCssFileParts("~/Themes/Kalibeenne/Content/css/styles.css");

    if (catalogSettings.DisplayAllPicturesOnCatalogPages)
    {
        NopHtml.AppendCssFileParts("~/lib_npm/swiper/swiper-bundle.min.css");
    }

    <script src="~/Themes/Kalibeenne/Content/scripts/Kalibeenne.js" asp-location="Footer"></script>
}
