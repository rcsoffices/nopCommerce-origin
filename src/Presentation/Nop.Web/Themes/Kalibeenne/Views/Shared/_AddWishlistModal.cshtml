@model int

<div id="addWishlistModal_@Model" class="kali-modal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="wishlistModalTitle_@Model">
    <div class="kali-modal-box">
        <div class="kali-modal-header">
            <h3 id="wishlistModalTitle_@Model" class="kali-modal-title">@T("Wishlist.AddNewWishlist")</h3>
            <button type="button" class="kali-modal-close" onclick="closeAddWishlistModal(@Model)" aria-label="Fermer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="kali-modal-body add-wishlist-content">
            <input type="text"
                   id="wishlistName_@Model"
                   class="kali-modal-input"
                   placeholder="@T("Wishlist.EnterWishlistName")"
                   onkeydown="if(event.keyCode===13) addWishlist(@Model)" />
        </div>
        <div class="kali-modal-footer">
            <button type="button" class="kali-modal-btn kali-modal-btn--secondary" onclick="closeAddWishlistModal(@Model)">@T("Common.Cancel")</button>
            <button type="button" class="kali-modal-btn kali-modal-btn--primary wishlist-add-custom-button" onclick="addWishlist(@Model)">@T("Common.OK")</button>
        </div>
    </div>
</div>

<script asp-location="Footer">
    function showAddWishlistModal(productId) {
        var $overlay = $('#addWishlistModal_' + productId);
        $overlay.fadeIn(180);
        setTimeout(function () {
            $('#wishlistName_' + productId).focus();
        }, 200);
    }

    function closeAddWishlistModal(productId) {
        $('#addWishlistModal_' + productId).fadeOut(150);
        $('#wishlistName_' + productId).val('');
    }

    function addWishlist(productId) {
        const wishlistName = document.getElementById('wishlistName_' + productId).value.trim();
        if (!wishlistName) {
            $('#wishlistName_' + productId).addClass('kali-modal-input--error').focus();
            return;
        }
        $('#wishlistName_' + productId).removeClass('kali-modal-input--error');
        AjaxCart.createCustomWishlist('@Url.RouteUrl(NopRouteNames.Ajax.ADD_WISHLIST)', wishlistName, productId);
        closeAddWishlistModal(productId);
    }

    // Close on overlay click
    $(document).on('click', '#addWishlistModal_@Model', function (e) {
        if (e.target === this) closeAddWishlistModal(@Model);
    });

    // Close on Escape
    $(document).on('keydown.wishlistModal_@Model', function (e) {
        if (e.key === 'Escape' && $('#addWishlistModal_@Model').is(':visible')) {
            closeAddWishlistModal(@Model);
        }
    });
</script>
