@model OnePageCheckoutModel
@using Nop.Core
@using Nop.Services.Customers
@inject IWebHelper webHelper
@inject IWorkContext workContext
@inject ICustomerService _customerService
@{
    Layout = "_ColumnsOne";

    var storeLocation = webHelper.GetStoreLocation();
    var isGuest = await _customerService.IsGuestAsync(await workContext.GetCurrentCustomerAsync());

    NopHtml.AddTitleParts(T("PageTitle.Checkout").Text);
    NopHtml.AppendPageCssClassParts("html-checkout-page");
}
@{
    var billingAddressStepNumber = 1;
    var shippingAddressStepNumber = 2;
    var shippingMethodStepNumber = 3;
    var paymentMethodStepNumber = 4;
    var confirmOrderStepNumber = 5; // payment info is merged into payment method step
    if (!Model.ShippingRequired)
    {
        paymentMethodStepNumber -= 2;
        confirmOrderStepNumber -= 2;
    }
    if (Model.DisableBillingAddressCheckoutStep)
    {
        shippingAddressStepNumber--;
        shippingMethodStepNumber--;
        paymentMethodStepNumber--;
        confirmOrderStepNumber--;
    }
}

<script src="~/js/public.accordion.js" asp-location="Footer"></script>
<script src="~/js/public.onepagecheckout.js" asp-location="Footer"></script>

<div class="page checkout-page kali-checkout-page kali-onestep-page">

    <div class="kali-checkout-header">
        <h1 class="kali-checkout-title">@T("Checkout")</h1>
    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OpcContentBefore, additionalData = Model })

    <div class="kali-onestep-layout">

        @* ── Left column : OPC accordion steps ── *@
        <div class="kali-onestep-left">
            <ol class="opc kali-opc-steps" id="checkout-steps">

                @* Step: Billing address *@
                <li id="opc-billing" class="tab-section allow">
                    <div class="step-title">
                        <span class="kali-step-number">@billingAddressStepNumber</span>
                        <h2 class="kali-step-name">@T("Checkout.BillingAddress")</h2>
                        <svg class="kali-step-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>
                    <div id="checkout-step-billing" class="step a-item" style="display:none;">
                        <div class="kali-step-body">
                            <form id="co-billing-form" action="" method="post">
                                <div id="checkout-billing-load">
                                    @await Html.PartialAsync("OpcBillingAddress", Model.BillingAddress)
                                </div>
                            </form>
                        </div>
                        <div class="kali-step-footer" id="billing-buttons-container">
                            <button id="save-billing-address-button" type="button" class="kali-btn-secondary" style="display:none" onclick="Billing.saveEditAddress('@(storeLocation)checkout/SaveEditBillingAddress/'); return false;">@T("Common.Save")</button>
                            <button type="button" name="save" class="kali-btn-continue new-address-next-step-button" onclick="Billing.save()">@T("Common.Continue")</button>
                            <span class="kali-please-wait" id="billing-please-wait" style="display:none;"><span class="kali-spinner"></span> @T("Common.LoadingNextStep")</span>
                        </div>
                    </div>
                    <script asp-location="Footer">
                        Billing.init('#co-billing-form', '@(storeLocation)checkout/GetAddressById/',
                            '@(storeLocation)checkout/OpcSaveBilling/',
                            @(Model.DisableBillingAddressCheckoutStep.ToString().ToLowerInvariant()),
                            @(isGuest.ToString().ToLowerInvariant()));
                        if ($("#billing-address-select").length > 0) {
                            Billing.newAddress(!$('#billing-address-select').val());
                        }
                    </script>
                </li>

                @* Steps: Shipping address + method (conditional) *@
                @if (Model.ShippingRequired)
                {
                    <li id="opc-shipping" class="tab-section">
                        <div class="step-title">
                            <span class="kali-step-number">@shippingAddressStepNumber</span>
                            <h2 class="kali-step-name">@T("Checkout.ShippingAddress")</h2>
                            <svg class="kali-step-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div id="checkout-step-shipping" class="step a-item" style="display:none;">
                            <div class="kali-step-body">
                                <form action="" id="co-shipping-form" method="post">
                                    <div id="checkout-shipping-load"></div>
                                </form>
                            </div>
                            <div class="kali-step-footer" id="shipping-buttons-container">
                                @if (!Model.DisableBillingAddressCheckoutStep)
                                {
                                    <a href="#" class="kali-back-link" onclick="Checkout.back(); return false;">&#8592; @T("Common.Back")</a>
                                }
                                <span id="edit-shipping-address-buttons">
                                    <button id="save-shipping-address-button" type="button" class="kali-btn-secondary" style="display:none" onclick="Shipping.saveEditAddress('@(storeLocation)checkout/SaveEditShippingAddress/'); return false;">@T("Common.Save")</button>
                                </span>
                                <button type="button" class="kali-btn-continue new-address-next-step-button" onclick="Shipping.save()">@T("Common.Continue")</button>
                                <span id="shipping-please-wait" class="kali-please-wait" style="display:none;"><span class="kali-spinner"></span> @T("Common.LoadingNextStep")</span>
                            </div>
                        </div>
                        <script asp-location="Footer">
                            Shipping.init('#co-shipping-form', '@(storeLocation)checkout/OpcSaveShipping/');
                            if ($("#shipping-address-select").length > 0) {
                                Shipping.newAddress($('#shipping-address-select').val(), @Model.BillingAddress.BillingNewAddress.Id);
                            }
                        </script>
                    </li>
                    <li id="opc-shipping_method" class="tab-section">
                        <div class="step-title">
                            <span class="kali-step-number">@shippingMethodStepNumber</span>
                            <h2 class="kali-step-name">@T("Checkout.ShippingMethod")</h2>
                            <svg class="kali-step-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div id="checkout-step-shipping-method" class="step a-item" style="display:none;">
                            <div class="kali-step-body">
                                <form id="co-shipping-method-form" action="" method="post">
                                    <div id="checkout-shipping-method-load"></div>
                                </form>
                            </div>
                            <div class="kali-step-footer" id="shipping-method-buttons-container">
                                <a href="#" class="kali-back-link" onclick="Checkout.back(); return false;">&#8592; @T("Common.Back")</a>
                                <button type="button" class="kali-btn-continue shipping-method-next-step-button" onclick="ShippingMethod.save()">@T("Common.Continue")</button>
                                <span id="shipping-method-please-wait" class="kali-please-wait" style="display:none;"><span class="kali-spinner"></span> @T("Common.LoadingNextStep")</span>
                            </div>
                        </div>
                        <script asp-location="Footer">
                            var localized_data = {
                                NotAvailableMethodsError: "@T("ShippingMethod.NotAvailableMethodsError")",
                                SpecifyMethodError: "@T("ShippingMethod.SpecifyMethodError")"
                            };
                            ShippingMethod.init('#co-shipping-method-form', '@(storeLocation)checkout/OpcSaveShippingMethod/', localized_data);
                        </script>
                    </li>
                }

                @* Step: Payment method + info (fusionnés) *@
                <li id="opc-payment_method" class="tab-section">
                    <div class="step-title">
                        <span class="kali-step-number">@paymentMethodStepNumber</span>
                        <h2 class="kali-step-name">@T("Checkout.PaymentMethod")</h2>
                        <svg class="kali-step-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>
                    <div id="checkout-step-payment-method" class="step a-item" style="display:none;">
                        <div class="kali-step-body">
                            <form action="" id="co-payment-method-form" method="post">
                                <div id="checkout-payment-method-load"></div>
                            </form>
                            @* Formulaire de paiement affiché inline après sélection *@
                            <div id="checkout-payment-info-inline" class="kali-payment-info-inline" style="display:none;">
                                <form action="" id="co-payment-info-form" method="post">
                                    <div id="checkout-payment-info-load"></div>
                                </form>
                            </div>
                        </div>
                        <div class="kali-step-footer" id="payment-method-buttons-container">
                            <a href="#" class="kali-back-link" onclick="Checkout.back(); return false;">&#8592; @T("Common.Back")</a>
                            <button type="button" name="save" id="kali-payment-continue-btn" class="kali-btn-continue payment-method-next-step-button" onclick="PaymentMethod.save()">@T("Common.Continue")</button>
                            <span class="kali-please-wait" id="payment-method-please-wait" style="display:none;"><span class="kali-spinner"></span> @T("Common.LoadingNextStep")</span>
                        </div>
                    </div>
                    <script asp-location="Footer">
                        var localized_data = {
                            NotAvailableMethodsError: "@T("PaymentMethod.NotAvailableMethodsError")",
                            SpecifyMethodError: "@T("PaymentMethod.SpecifyMethodError")"
                        };
                        PaymentMethod.init('#co-payment-method-form', '@(storeLocation)checkout/OpcSavePaymentMethod/', localized_data);
                        PaymentInfo.init('#co-payment-info-form', '@(storeLocation)checkout/OpcSavePaymentInfo/');
                    </script>
                </li>

                @* Étape payment info cachée — requise par le JS OPC, non affichée comme étape accordion *@
                <li id="opc-payment_info" class="tab-section" style="display:none !important;">
                    <div class="step-title"></div>
                    <div id="checkout-step-payment-info" class="step a-item"></div>
                    <div id="payment-info-buttons-container" style="display:none;">
                        <button type="button" class="payment-info-next-step-button" onclick="PaymentInfo.save()"></button>
                        <span id="payment-info-please-wait" class="kali-please-wait" style="display:none;"></span>
                    </div>
                </li>

                @* Step: Confirm order *@
                <li id="opc-confirm_order" class="tab-section">
                    <div class="step-title">
                        <span class="kali-step-number">@confirmOrderStepNumber</span>
                        <h2 class="kali-step-name">@T("Checkout.ConfirmOrder")</h2>
                        <svg class="kali-step-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>
                    <div id="checkout-step-confirm-order" class="step a-item" style="display:none;">
                        <div class="kali-step-body">
                            <div id="checkout-confirm-order-load"></div>
                        </div>
                        <div class="kali-step-footer" id="confirm-order-buttons-container">
                            <a href="#" class="kali-back-link" onclick="Checkout.back(); return false;">&#8592; @T("Common.Back")</a>
                            <button type="button" class="kali-btn-confirm confirm-order-next-step-button" onclick="ConfirmOrder.save()">@T("Checkout.ConfirmButton")</button>
                            <span class="kali-please-wait" id="confirm-order-please-wait" style="display:none;"><span class="kali-spinner"></span> @T("Checkout.SubmittingOrder")</span>
                        </div>
                    </div>
                    <script asp-location="Footer">
                        ConfirmOrder.init('@(storeLocation)checkout/OpcConfirmOrder/',
                            '@Url.RouteUrl(NopRouteNames.Standard.CHECKOUT_COMPLETED)',
                            @Model.DisplayCaptcha.ToString().ToLowerInvariant(),
                            @Model.IsReCaptchaV3.ToString().ToLowerInvariant(),
                            '@Model.ReCaptchaPublicKey',
                            '#checkout-step-confirm-order');
                    </script>
                </li>

            </ol>
        </div>

        @* ── Right column : sticky order summary ── *@
        <div class="kali-onestep-right">
            <div class="kali-os-card kali-os-summary-card">
                <div class="kali-os-card-header kali-os-summary-header" role="button" tabindex="0" aria-expanded="false">
                    <span class="kali-os-card-icon" aria-hidden="true">&#128722;</span>
                    <h2 class="kali-os-card-title">Mon panier</h2>
                    <svg class="kali-os-summary-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
                <div class="kali-os-card-body kali-os-summary-body">
                    @await Component.InvokeAsync(typeof(OrderSummaryViewComponent))
                </div>
            </div>
        </div>

    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OpcContentAfter, additionalData = Model })

</div>

<script asp-location="Footer">
    Accordion.init('checkout-steps', '.step-title', true);
    Accordion.openSection('#opc-billing');
    Checkout.init('@(storeLocation)cart/');
    if (Billing.disableBillingAddressCheckoutStep) {
        Accordion.hideSection('#opc-billing');
        Billing.save();
    }

    // ── Fusion payment method + payment info dans une seule étape ──
    (function () {
        var _origOpen = Accordion.openSection.bind(Accordion);

        Accordion.openSection = function (section) {
            var sectionId = $(section).attr('id');

            if (sectionId === 'opc-payment_info') {
                // Afficher le formulaire inline — NE PAS changer currentSectionId
                // (reste sur opc-payment_method pour que closeExistingSection fonctionne)
                $('#checkout-payment-info-inline').slideDown(200);
                $('#kali-payment-continue-btn')
                    .removeClass('payment-method-next-step-button')
                    .addClass('payment-info-next-step-button')
                    .attr('onclick', 'PaymentInfo.save()');
                return;
            }

            // En quittant la zone paiement, réinitialiser l'état inline
            if (sectionId !== 'opc-payment_method') {
                $('#checkout-payment-info-inline').hide();
                $('#checkout-payment-info-load').empty();
                $('#kali-payment-continue-btn')
                    .removeClass('payment-info-next-step-button')
                    .addClass('payment-method-next-step-button')
                    .attr('onclick', 'PaymentMethod.save()');
            }

            var result = _origOpen.call(Accordion, section);

            // Si l'étape payment method s'ouvre avec un radio déjà sélectionné,
            // charger le formulaire de paiement immédiatement
            if (sectionId === 'opc-payment_method') {
                if ($('input[name="paymentmethod"]:checked').length > 0) {
                    PaymentMethod.save();
                }
            }

            return result;
        };

        // Au clic sur un radio de méthode de paiement → charger le formulaire immédiatement
        $(document).on('change', 'input[name="paymentmethod"]', function () {
            // Réinitialiser l'état inline avant le rechargement
            $('#checkout-payment-info-inline').hide();
            $('#checkout-payment-info-load').empty();
            $('#kali-payment-continue-btn')
                .removeClass('payment-info-next-step-button')
                .addClass('payment-method-next-step-button')
                .attr('onclick', 'PaymentMethod.save()');
            // Déclencher automatiquement la sauvegarde → chargement du formulaire inline
            PaymentMethod.save();
        });
    })();
</script>
