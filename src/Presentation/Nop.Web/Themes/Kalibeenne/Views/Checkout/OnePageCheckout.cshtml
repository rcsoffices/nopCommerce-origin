@model OnePageCheckoutModel
@using Nop.Core
@using Nop.Services.Customers
@inject IWebHelper webHelper
@inject IWorkContext workContext
@inject ICustomerService _customerService
@{
    Layout = "_ColumnsOne";

    var storeLocation = webHelper.GetStoreLocation();
    var isGuest = await _customerService.IsGuestAsync(await workContext.GetCurrentCustomerAsync());

    NopHtml.AddTitleParts(T("PageTitle.Checkout").Text);
    NopHtml.AppendPageCssClassParts("html-checkout-page");
}

@* nopCommerce OPC scripts - required for Billing/Shipping/PaymentMethod/PaymentInfo/ConfirmOrder objects *@
<script src="~/js/public.accordion.js" asp-location="Footer"></script>
<script src="~/js/public.onepagecheckout.js" asp-location="Footer"></script>

<div class="page checkout-page kali-checkout-page kali-onestep-page">

    <div class="kali-checkout-header">
        <h1 class="kali-checkout-title">@T("Checkout")</h1>
    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OpcContentBefore, additionalData = Model })

    <div class="kali-onestep-layout">

        @* -- Colonne gauche : formulaires -- *@
        <div class="kali-onestep-left">

            @* -- 1. Contact (email) - invites uniquement -- *@
            @if (isGuest)
            {
                <div class="kali-os-card" id="kali-os-contact-card">
                    <div class="kali-os-card-header">
                        <span class="kali-os-card-icon" aria-hidden="true">&#9993;</span>
                        <h2 class="kali-os-card-title">Contact</h2>
                    </div>
                    <div class="kali-os-card-body">
                        <div class="inputs">
                            <label for="kali-contact-email">Adresse e-mail</label>
                            <input type="email" id="kali-contact-email" name="kali-contact-email"
                                   placeholder="votre@email.fr" autocomplete="email" />
                        </div>
                        <p class="kali-os-login-hint">
                            Vous avez deja un compte ?
                            <a href="/login?returnUrl=%2Fcheckout">Se connecter</a>
                        </p>
                    </div>
                </div>
            }

            @* -- 2. Adresse de facturation -- *@
            @if (!Model.DisableBillingAddressCheckoutStep)
            {
                <div class="kali-os-card" id="kali-os-address-card">
                    <div class="kali-os-card-header">
                        <span class="kali-os-card-icon" aria-hidden="true">&#128205;</span>
                        <h2 class="kali-os-card-title">@T("Checkout.BillingAddress")</h2>
                    </div>
                    <div class="kali-os-card-body">
                        <div id="kali-billing-render"></div>
                    </div>
                </div>
            }

            @* -- 3. Mode de livraison -- *@
            @if (Model.ShippingRequired)
            {
                <div class="kali-os-card" id="kali-os-shipping-card">
                    <div class="kali-os-card-header">
                        <span class="kali-os-card-icon" aria-hidden="true">&#128666;</span>
                        <h2 class="kali-os-card-title">@T("Checkout.ShippingMethod")</h2>
                    </div>
                    <div class="kali-os-card-body">
                        <div id="kali-shipping-method-render">
                            <div class="kali-os-loading-hint">
                                <span class="kali-spinner-sm"></span> Chargement des modes de livraison...
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* -- 4. Methode de paiement -- *@
            <div class="kali-os-card" id="kali-os-payment-card">
                <div class="kali-os-card-header">
                    <span class="kali-os-card-icon" aria-hidden="true">&#128179;</span>
                    <h2 class="kali-os-card-title">@T("Checkout.PaymentMethod")</h2>
                </div>
                <div class="kali-os-card-body">
                    <div id="kali-payment-method-render">
                        <div class="kali-os-loading-hint">
                            <span class="kali-spinner-sm"></span> Chargement des methodes de paiement...
                        </div>
                    </div>
                    <div id="kali-payment-info-render" class="kali-os-payment-plugin" style="display:none">
                        <h3 class="kali-os-subsection-title kali-os-plugin-title">@T("Checkout.PaymentInfo")</h3>
                        <div id="kali-payment-plugin-fields"></div>
                    </div>
                </div>
            </div>

            @* -- Erreurs globales -- *@
            <div id="kali-os-errors" class="kali-os-error-box" style="display:none" role="alert"></div>

            @* -- CGV (affiche dynamiquement si requis) -- *@
            <div id="kali-os-tos" class="kali-os-tos-block" style="display:none">
                <label class="kali-os-checkbox-label">
                    <input type="checkbox" id="kali-termsofservice" name="termsofservice" />
                    <span>@T("Checkout.TermsOfService.IAccept")
                        <a href="@await NopUrl.RouteTopicUrlAsync("conditionsofuse")" target="_blank">@T("Checkout.TermsOfService.Read")</a>
                    </span>
                </label>
            </div>

            @* -- Bouton Payer -- *@
            <div class="kali-os-cta-row">
                <button type="button" id="kali-os-pay-btn" class="kali-os-pay-btn">
                    <span class="kali-os-btn-text">Payer maintenant</span>
                    <span class="kali-spinner kali-os-btn-spinner" style="display:none" aria-hidden="true"></span>
                </button>
            </div>

        </div>

        @* -- Colonne droite : resume panier -- *@
        <div class="kali-onestep-right">
            <div class="kali-os-card kali-os-summary-card">
                <div class="kali-os-card-body kali-os-summary-body">
                    @await Component.InvokeAsync(typeof(OrderSummaryViewComponent))
                </div>
            </div>
        </div>

    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OpcContentAfter, additionalData = Model })

    @* -- Sections OPC cachees - requises par public.onepagecheckout.js -- *@
    <div id="kali-opc-hidden" aria-hidden="true" style="display:none">
        <ol id="checkout-steps">
            <li id="opc-billing" class="tab-section allow">
                <span class="step-title"></span>
                <div id="checkout-step-billing" class="step a-item">
                    <form id="co-billing-form" action="" method="post">
                        <div id="checkout-billing-load">
                            @await Html.PartialAsync("OpcBillingAddress", Model.BillingAddress)
                        </div>
                    </form>
                    <div id="billing-buttons-container"></div>
                </div>
            </li>
            @if (Model.ShippingRequired)
            {
                <li id="opc-shipping" class="tab-section">
                    <span class="step-title"></span>
                    <div id="checkout-step-shipping" class="step a-item">
                        <form action="" id="co-shipping-form" method="post">
                            <div id="checkout-shipping-load"></div>
                        </form>
                        <div id="shipping-buttons-container"></div>
                    </div>
                </li>
                <li id="opc-shipping_method" class="tab-section">
                    <span class="step-title"></span>
                    <div id="checkout-step-shipping-method" class="step a-item">
                        <form id="co-shipping-method-form" action="" method="post">
                            <div id="checkout-shipping-method-load"></div>
                        </form>
                        <div id="shipping-method-buttons-container"></div>
                    </div>
                </li>
            }
            <li id="opc-payment_method" class="tab-section">
                <span class="step-title"></span>
                <div id="checkout-step-payment-method" class="step a-item">
                    <form action="" id="co-payment-method-form" method="post">
                        <div id="checkout-payment-method-load"></div>
                    </form>
                    <div id="payment-method-buttons-container"></div>
                </div>
            </li>
            <li id="opc-payment_info" class="tab-section">
                <span class="step-title"></span>
                <div id="checkout-step-payment-info" class="step a-item">
                    <form action="" id="co-payment-info-form" method="post">
                        <div id="checkout-payment-info-load"></div>
                    </form>
                    <div id="payment-info-buttons-container"></div>
                </div>
            </li>
            <li id="opc-confirm_order" class="tab-section">
                <span class="step-title"></span>
                <div id="checkout-step-confirm-order" class="step a-item">
                    <div id="checkout-confirm-order-load"></div>
                    <div id="confirm-order-buttons-container"></div>
                </div>
            </li>
        </ol>
    </div>

</div>

@* -- Initialisation OPC -- *@
<script asp-location="Footer">
(function ($) {
    Accordion.openSection = function () {};
    Accordion.hideSection = function () {};
    Accordion.init('checkout-steps', '.step-title', false);
    Checkout.init('@(storeLocation)cart/');

    Billing.init(
        '#co-billing-form',
        '@(storeLocation)checkout/GetAddressById/',
        '@(storeLocation)checkout/OpcSaveBilling/',
        @(Model.DisableBillingAddressCheckoutStep.ToString().ToLowerInvariant()),
        @(isGuest.ToString().ToLowerInvariant())
    );
    if ($('#billing-address-select').length > 0) {
        Billing.newAddress(!$('#billing-address-select').val());
    }

    @if (Model.ShippingRequired)
    {
        <text>
    Shipping.init('#co-shipping-form', '@(storeLocation)checkout/OpcSaveShipping/');
    ShippingMethod.init('#co-shipping-method-form', '@(storeLocation)checkout/OpcSaveShippingMethod/', {
        NotAvailableMethodsError: "@T("ShippingMethod.NotAvailableMethodsError")",
        SpecifyMethodError: "@T("ShippingMethod.SpecifyMethodError")"
    });
        </text>
    }

    PaymentMethod.init('#co-payment-method-form', '@(storeLocation)checkout/OpcSavePaymentMethod/', {
        NotAvailableMethodsError: "@T("PaymentMethod.NotAvailableMethodsError")",
        SpecifyMethodError: "@T("PaymentMethod.SpecifyMethodError")"
    });
    PaymentInfo.init('#co-payment-info-form', '@(storeLocation)checkout/OpcSavePaymentInfo/');
    ConfirmOrder.init(
        '@(storeLocation)checkout/OpcConfirmOrder/',
        '@Url.RouteUrl(NopRouteNames.Standard.CHECKOUT_COMPLETED)',
        @Model.DisplayCaptcha.ToString().ToLowerInvariant(),
        @Model.IsReCaptchaV3.ToString().ToLowerInvariant(),
        '@Model.ReCaptchaPublicKey',
        '#checkout-step-confirm-order'
    );

    KaliCheckout.init({
        shippingRequired: @Model.ShippingRequired.ToString().ToLowerInvariant(),
        disableBillingStep: @Model.DisableBillingAddressCheckoutStep.ToString().ToLowerInvariant(),
        isGuest: @isGuest.ToString().ToLowerInvariant(),
        failureUrl: '@(storeLocation)cart/',
        termsRequired: false
    });
}(jQuery));
</script>