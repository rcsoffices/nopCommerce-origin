@model MenuItemModel

@using Nop.Web.Models.Menus

@if (Model.ChildrenItems.Count > 0)
{
    <li class="has-sublist">
        @if (Model.ParentId == null)
        {
            <div class="openSublistWrapper">
                <span class="show-submenu left"></span>
                <a class="with-subcategories" href="@Model.Url">@Model.Title</a>
                <span class="show-submenu right"></span>
            </div>
        }
        else
        {
            <a class="with-subcategories" href="@Model.Url">@Model.Title</a>
        }
        <div class="plus-button"></div>
        <div class="sublist-wrap">
            <ul class="sublist">
                <li class="back-button">
                    <span>@T("SevenSpikes.Themes.Common.BackSublist")</span>
                </li>
                @foreach (var child in Model.ChildrenItems)
                {
                    @await Html.PartialAsync("_CategoryLine.TopMenu", child)
                }
            </ul>
        </div>
    </li>
}
else
{
    <li>
        <a href="@Model.Url">@Model.Title</a>
    </li>
}
